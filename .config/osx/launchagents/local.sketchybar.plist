<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.sketchybar</string>
  <key>ProgramArguments</key>
  <array><string>/opt/homebrew/bin/sketchybar</string></array>
  <key>WorkingDirectory</key><string>/Users/oslen/.config/sketchybar</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/oslen</string>
    <key>USER</key><string>oslen</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/Users/oslen/.local/state/sketchybar/sketchybar.log</string>
  <key>StandardErrorPath</key><string>/Users/oslen/.local/state/sketchybar/sketchybar.log</string>
</dict>
</plist>
