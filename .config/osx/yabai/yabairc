#!/usr/bin/env sh

# ============================================================
# yabai configuration
# Modifier: ALT (Option)
# ============================================================

# Load scripting addition
yabai -m signal --add event=dock_did_restart action="$HOME/.config/yabai/scripts/load_sa.sh"
$HOME/.config/yabai/scripts/load_sa.sh

# ── Layout ──────────────────────────────────────────────────
yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config split_ratio 0.50
yabai -m config auto_balance off

# ── Gaps & Padding ──────────────────────────────────────────
yabai -m config top_padding 17
yabai -m config bottom_padding 17
yabai -m config left_padding 17
yabai -m config right_padding 17
yabai -m config window_gap 4

# ── Window Appearance ───────────────────────────────────────
yabai -m config window_shadow on
yabai -m config window_opacity on
yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 0.95

# ── Mouse ───────────────────────────────────────────────────
yabai -m config focus_follows_mouse autoraise
yabai -m config mouse_follows_focus off
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

# ── External Bar ────────────────────────────────────────────
yabai -m config external_bar off:0:0

# ── Workspace Setup ─────────────────────────────────────────
TARGET_SPACES=7
CURRENT=$(yabai -m query --spaces 2>/dev/null | jq 'length' 2>/dev/null || echo 0)

if [ "$CURRENT" -lt "$TARGET_SPACES" ]; then
    for i in $(seq $((CURRENT + 1)) "$TARGET_SPACES"); do
        yabai -m space --create 2>/dev/null || true
    done
fi

# ── Window Rules ────────────────────────────────────────────
yabai -m rule --add app="^System Preferences$" manage=off
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner" manage=off
yabai -m rule --add app="^QuickTime Player$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off
yabai -m rule --add app="^Finder$" title="^(Copy|Move|Connect|Info|Pref)" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^App Store$" manage=off
yabai -m rule --add app="^Disk Utility$" manage=off
yabai -m rule --add app="^Software Update$" manage=off
yabai -m rule --add app="^Font Book$" manage=off
yabai -m rule --add app="^Digital Colo[u]?r Meter$" manage=off
yabai -m rule --add app="^Stickies$" manage=off
yabai -m rule --add app="^Preview$" manage=off
yabai -m rule --add app="^Raycast$" manage=off
yabai -m rule --add app="^Spotlight$" manage=off

# Remember Finder's last real folder before its windows are closed.
yabai -m signal --add label=finder_remember_focus event=window_focused app="^Finder$" action="$HOME/.config/skhd/scripts/finder_window.sh remember"
yabai -m signal --add label=finder_remember_folder event=window_title_changed app="^Finder$" active=yes action="$HOME/.config/skhd/scripts/finder_window.sh remember"

# ── STRICT 5-WINDOW LIMIT ─────────────────────────────────────
# Enforces exactly 5 managed windows per space maximum
yabai -m signal --add event=window_created action="$HOME/.config/yabai/scripts/limit_windows.sh"

# ── Secondary Display: auto-tile with orientation-aware splits ──
# External displays use BSP so windows auto-tile. Yabai's BSP picks
# the split axis from container aspect ratio, so a horizontal monitor
# splits side-by-side and a vertical (portrait) monitor stacks
# windows top/bottom. The script also seeds split_type per-space
# from each display's frame to bias the first split correctly.

$HOME/.config/yabai/scripts/secondary_bsp.sh >/dev/null 2>&1 || true

# Re-apply only on display connect/disconnect. Do NOT bind to
# display_changed — that fires on every focus change between displays
# and causes secondary_bsp.sh to re-tile windows on the secondary
# display, undoing manual swaps (e.g. Zen ↔ Obsidian on a portrait
# monitor reverting whenever focus returns to the primary display).
yabai -m signal --add event=display_added action="$HOME/.config/yabai/scripts/secondary_bsp.sh"
yabai -m signal --add event=display_removed action="$HOME/.config/yabai/scripts/secondary_bsp.sh"

# ── Enforce 5-window limit on startup ───────────────────────
# Handles windows restored before yabai started
$HOME/.config/yabai/scripts/enforce_limit_on_startup.sh >/dev/null 2>&1 &

# ── Window Borders ──────────────────────────────────────────
borders style=round width=5.0 active_color=0xffd79921 inactive_color=0xffd79921 &

echo "yabai configuration loaded."
