# ============================================================
# skhd configuration — ported from Hyprland keybindings
# Main modifier: ALT (Option key)
# ============================================================
#
# NOTE on workspace switching:
# yabai -m space --focus N requires the scripting addition.
# If SA is unavailable, we fall back to macOS native ctrl+N shortcuts.
# Enable them in: System Settings > Keyboard > Keyboard Shortcuts >
# Mission Control > "Switch to Desktop N" (check all 10).
# ============================================================

# ── Terminal ────────────────────────────────────────────────
alt - q : open -na "Ghostty"
alt - return : open -na "Ghostty"

# ── Window Management ──────────────────────────────────────
alt - c : PID=$(yabai -m query --windows --window mouse | jq -r '.pid // empty'); [ -n "$PID" ] && kill -9 "$PID"
alt - f : ~/.config/skhd/scripts/toggle_hypr_fullscreen.sh
alt - v : yabai -m window --toggle float; \
yabai -m window --grid 4:4:1:1:2:2
alt - p : yabai -m window --toggle zoom-parent
alt - g : yabai -m window --toggle split

# ── App Launcher ────────────────────────────────────────────
alt - space : skhd -k "cmd - space"

# ── File Manager ────────────────────────────────────────────
alt - e : open -a "Finder"

# ── App-specific launcher helpers ───────────────────────────
shift + alt - z : ~/.config/skhd/scripts/open_zen_here.sh

# ── Focus Movement (vim-style) ─────────────────────────────
# Smart focus: crosses display boundaries when no window in direction
alt - h : ~/.config/skhd/scripts/focus_window.sh west
alt - j : ~/.config/skhd/scripts/focus_window.sh south
alt - k : ~/.config/skhd/scripts/focus_window.sh north
alt - l : ~/.config/skhd/scripts/focus_window.sh east

# ── Resize Windows ─────────────────────────────────────────
alt - left : yabai -m window --resize left:-20:0 || yabai -m window --resize right:-20:0
alt - right : yabai -m window --resize right:20:0 || yabai -m window --resize left:20:0
alt - down : yabai -m window --resize bottom:0:20 || yabai -m window --resize top:0:20
alt - up : yabai -m window --resize top:0:-20 || yabai -m window --resize bottom:0:-20

# ── Move Floating Windows ──────────────────────────────────
shift + alt - h : yabai -m window --move rel:-20:0
shift + alt - l : yabai -m window --move rel:20:0
shift + alt - k : yabai -m window --move rel:0:-20
shift + alt - j : yabai -m window --move rel:0:20

# ── Move Windows Between Positions ─────────────────────────
ctrl + alt - h : yabai -m window --swap west
ctrl + alt - j : yabai -m window --swap south
ctrl + alt - k : yabai -m window --swap north
ctrl + alt - l : yabai -m window --swap east

# ── Workspace Switching ────────────────────────────────────
alt - 0x12 : ~/.config/skhd/scripts/focus_or_create_space.sh 1
alt - 0x13 : ~/.config/skhd/scripts/focus_or_create_space.sh 2
alt - 0x14 : ~/.config/skhd/scripts/focus_or_create_space.sh 3
alt - 0x15 : ~/.config/skhd/scripts/focus_or_create_space.sh 4
alt - 0x17 : ~/.config/skhd/scripts/focus_or_create_space.sh 5
alt - 0x16 : ~/.config/skhd/scripts/focus_or_create_space.sh 6
alt - 0x1A : ~/.config/skhd/scripts/focus_or_create_space.sh 7
alt - 0x1C : ~/.config/skhd/scripts/focus_or_create_space.sh 8
alt - 0x19 : ~/.config/skhd/scripts/focus_or_create_space.sh 9
alt - 0x1D : ~/.config/skhd/scripts/focus_or_create_space.sh 10

# ── Move Window to Workspace ───────────────────────────────
shift + alt - 0x12 : ~/.config/skhd/scripts/move_hovered_to_space.sh 1
shift + alt - 0x13 : ~/.config/skhd/scripts/move_hovered_to_space.sh 2
shift + alt - 0x14 : ~/.config/skhd/scripts/move_hovered_to_space.sh 3
shift + alt - 0x15 : ~/.config/skhd/scripts/move_hovered_to_space.sh 4
shift + alt - 0x17 : ~/.config/skhd/scripts/move_hovered_to_space.sh 5
shift + alt - 0x16 : ~/.config/skhd/scripts/move_hovered_to_space.sh 6
shift + alt - 0x1A : ~/.config/skhd/scripts/move_hovered_to_space.sh 7
shift + alt - 0x1C : ~/.config/skhd/scripts/move_hovered_to_space.sh 8
shift + alt - 0x19 : ~/.config/skhd/scripts/move_hovered_to_space.sh 9
shift + alt - 0x1D : ~/.config/skhd/scripts/move_hovered_to_space.sh 10

# ── Workspace Management ───────────────────────────────────
alt - n : yabai -m space --create 2>/dev/null && yabai -m space --focus last 2>/dev/null
alt - tab : yabai -m window --focus stack.next || yabai -m window --focus stack.first
shift + alt - tab : yabai -m window --focus stack.prev || yabai -m window --focus stack.last

# ── Scroll Through Workspaces ──────────────────────────────
alt - 0x21 : yabai -m space --focus prev 2>/dev/null || skhd -k "ctrl - left"
alt - 0x1E : yabai -m space --focus next 2>/dev/null || skhd -k "ctrl - right"

# ── Display Focus ──────────────────────────────────────────
ctrl + alt - left : yabai -m display --focus west 2>/dev/null || true
ctrl + alt - right : yabai -m display --focus east 2>/dev/null || true

# ── Move Window to Display ─────────────────────────────────
shift + ctrl + alt - left : yabai -m window --display west 2>/dev/null || true
shift + ctrl + alt - right : yabai -m window --display east 2>/dev/null || true

# ── Lock Screen ────────────────────────────────────────────
alt - escape : pmset displaysleepnow

# ── Logout/Power ───────────────────────────────────────────
alt - i : osascript -e 'tell app "System Events" to «event aevtrlgo»'

# ── Balance/Equalize Windows ──────────────────────────────
shift + alt - e : yabai -m space --balance
