{
  "lastChangelogVersion": "1.3.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "transport": "sse",
  "thinkingBudgets": {
    "minimal": 1024,
    "low": 4096,
    "medium": 10240,
    "high": 16384,
    "xhigh": 32768
  },
  "packages": [
    "npm:@spences10/pi-lsp",
    "npm:context-mode",
    "npm:pi-btw",
    "npm:@plannotator/pi-extension",
    "npm:pi-plan-mode",
    "npm:pi-nvidia-nim",
    "npm:pi-powerline-footer",
    "npm:pi-image-tools",
    "npm:@injaneity/pi-computer-use",
    "npm:@samfp/pi-memory",
    "npm:@kinarajv/pi-tps-extensions",
    "npm:@baggiiiie/pi-goal",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-openai-fast-mode",
    "npm:pi-token-burden",
    "npm:@diegopetrucci/pi-context-inspector",
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-kanban"
  ],
  "extensions": [
    "~/dotfiles/.config/shared/pi/agent/extensions/codex-usage.ts"
  ],
  "registries": {
    "@react-bits": "https://reactbits.dev/r/{name}.json"
  },
  "theme": "gruvbox-dark-hard",
  "enableInstallTelemetry": false,
  "hideThinkingBlock": false
}